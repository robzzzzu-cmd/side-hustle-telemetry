# ==============================================================================
# SIDE-HUSTLE-TELEMETRY CONFIGURATION
# Copy this file to .env for local testing or populate these values in GitHub Secrets
# ==============================================================================

# Discord Integration (Required for live alerts)
# Generate from Discord Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/your-webhook-token

# LLM Engine Credentials (Required for AI Growth Advisor)
# Set LLM_PROVIDER to "gemini" (recommended) or "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSyD-YourGeminiApiKeyHere
LLM_MODEL=gemini-1.5-flash

# Alternatively for OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-YourOpenAIApiKeyHere
# LLM_MODEL=gpt-4o-mini

# Roblox Open Cloud Integration
# Obtain from Creator Dashboard -> Open Cloud -> API Keys (Requires universe-analytics & datastore scopes)
ROBLOX_OPENCLOUD_KEY=rbx_live_your_roblox_open_cloud_api_key_here
ROBLOX_UNIVERSE_ID=1234567890

# Web Application Monitoring
# Comma-separated list of HTTP/HTTPS URLs to check for uptime, response latency, and SSL expiration
MONITORED_URLS=https://my-game-hub.com,https://api.my-game-hub.com/health,https://portfolio-showcase.dev

# Google Search Console (Optional)
# Set to 'true' to enable Search Console query telemetry
SEARCH_CONSOLE_ENABLED=false

# Simulation & Testing Flag
# Set to 'true' to execute without live external API keys using synthetic telemetry data
ENABLE_MOCK=false
